{
  "name": "zapax-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --env-file-if-exists=.env build.mjs",
    "build:production": "node --env-file-if-exists=.env build.mjs --production",
    "serve": "node scripts/serve.mjs",
    "qa": "node --env-file-if-exists=.env scripts/qa.mjs",
    "colors": "node scripts/colors.mjs --raster",
    "verify": "node --env-file-if-exists=.env scripts/verify.mjs",
    "assets": "node --env-file-if-exists=.env scripts/assets.mjs",
    "brand": "node --env-file-if-exists=.env scripts/brand.mjs",
    "test": "node scripts/test-inquiry.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "opentype.js": "^1.3.4",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=20.12"
  }
