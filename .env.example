# ZAPAX GLOBAL website: environment variables
# Copy to .env for local builds. In production, set these in your host's dashboard
# (Netlify: Site configuration > Environment variables; Cloudflare Pages: Settings > Variables).
# .env is git-ignored. Everything here is public EXCEPT the variables marked SECRET.

# ---------------------------------------------------------------- site (build time)
# Final origin: https, no trailing slash. The other www/non-www form redirects here.
# On Netlify it may stay empty: the project's primary URL (netlify.app, later your domain) is used automatically.
# NOTE: zapax.com is a parked domain owned by a third party. Use a domain ZAPAX GLOBAL has registered.
SITE_URL=
# Domain where ZAPAX GLOBAL mailboxes live (info@, chetan@, keval@). Defaults to the SITE_URL host without "www.".
EMAIL_DOMAIN=
# Public contact email (defaults to info@EMAIL_DOMAIN).
CONTACT_EMAIL=
# Phone and WhatsApp (defaults: +91 99980 50731 / 919998050731).
CONTACT_PHONE=
WHATSAPP_NUMBER=
# Registered company name. Defaults to ZAPAX GLOBAL LLP; override only if the registration changes.
LEGAL_NAME=
# Inquiry form target. Default /api/inquiry = built-in backend below; on Netlify without RESEND_API_KEY it is
# "netlify" (Netlify Forms). Can also be any form service URL.
FORM_ENDPOINT=
# Optional: Google Analytics 4 ID (update the privacy policy when enabled) and Search Console token.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Set to "cpanel" to include the PHP inquiry handler in dist/ for Apache/cPanel hosting.
DEPLOY_TARGET=

# ---------------------------------------------------------------- inquiry backend (runtime)
# Email delivery through Resend (resend.com). Verify your domain in Resend first.
# SECRET: never commit, set only in the host dashboard (or zapax-mail-config.php on cPanel).
RESEND_API_KEY=
# Sender shown to buyers, on your verified domain, e.g. ZAPAX GLOBAL <inquiries@yourdomain.com>
MAIL_FROM=
# Team inbox(es) that receive inquiries, comma-separated, e.g. info@yourdomain.com,chetan@yourdomain.com
MAIL_TO=
