# ZAPAX ENTERPRISE website: environment variables
# Copy to .env for local builds. In production, set these in your host's dashboard
# (Netlify: Site configuration > Environment variables; Cloudflare Pages: Settings > Variables).
# .env is git-ignored. Everything here is public EXCEPT the variables marked SECRET.

# ---------------------------------------------------------------- site (build time)
# Final origin: https, no trailing slash. The other www/non-www form redirects here.
# On Netlify it may stay empty: the project's primary URL (netlify.app, later your domain) is used automatically.
# NOTE: zapax.com is a parked domain owned by a third party. Use a domain ZAPAX ENTERPRISE has registered.
SITE_URL=
# Domain where ZAPAX ENTERPRISE mailboxes live (info@, chetan@, keval@). Defaults to the SITE_URL host without "www.".
EMAIL_DOMAIN=
# Public contact email (defaults to info@EMAIL_DOMAIN).
CONTACT_EMAIL=
# Phone and WhatsApp (defaults: +91 99980 50731 / 919998050731).
CONTACT_PHONE=
WHATSAPP_NUMBER=
# Registered company name. Defaults to ZAPAX ENTERPRISE LLP; override only if the registration changes.
LEGAL_NAME=
# Optional: Google Analytics 4 ID (update the privacy policy when enabled) and Search Console token.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- npm run deploy (Single Web Hosting): upload changed files over FTPS -------
# hPanel → Files → FTP Accounts. FTP_HOST: the IP or name only (no ftp://). FTP_DIR: the folder the WEBSITE is served
# from, as a full path starting with / . On Hostinger: /domains/zapaxenterprise.com/public_html (the FTP login's own
# public_html is a different folder that no website serves).
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_DIR=/domains/zapaxenterprise.com/public_html

# Quote form: every inquiry is saved to the EximFlow lead dashboard (Enquiries tab). No email is sent.
# Firebase web API key of the EximFlow project (VITE_FIREBASE_API_KEY in EximFlow's web/.env).
# Empty = the form opens the visitor's email app instead.
EXIMFLOW_API_KEY=
# EXIMFLOW_PROJECT=eximflow-73416
# EXIMFLOW_TENANT=tarang
